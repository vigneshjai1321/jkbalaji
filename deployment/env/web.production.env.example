# Copy to /var/www/jkbalaji/shared/web.env on the server. NEXT_PUBLIC_* values are inlined at BUILD time,
# so they must also be present wherever the build runs (local PC / CI).
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="JK Balaji"
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_API_BASE_PATH=/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
API_INTERNAL_URL=http://127.0.0.1:4000
AUTH_ACCESS_COOKIE_NAME=jkb_at
AUTH_REFRESH_COOKIE_NAME=jkb_rt
