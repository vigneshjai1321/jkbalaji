# Copy to /var/www/jkbalaji/shared/api.env on the server (chmod 600). Never commit real values.
NODE_ENV=production
APP_NAME="JK Balaji API"
APP_PORT=4000
APP_HOST=127.0.0.1
APP_GLOBAL_PREFIX=api
APP_DEFAULT_VERSION=1
APP_TIMEZONE=Asia/Kolkata
APP_WEB_ORIGIN=https://example.com
LOG_LEVEL=info

DATABASE_URL=postgresql://jkbalaji_app:STRONG_PASSWORD@127.0.0.1:5432/jkbalaji?schema=public
DATABASE_POOL_MAX=10

JWT_ACCESS_SECRET=GENERATE_WITH_openssl_rand_base64_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_ONE
JWT_REFRESH_TTL=7d
AUTH_ACCESS_COOKIE_NAME=jkb_at
AUTH_REFRESH_COOKIE_NAME=jkb_rt
AUTH_COOKIE_DOMAIN=example.com
AUTH_COOKIE_SECURE=true
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

UPLOAD_DIR=/var/www/jkbalaji/shared/uploads
UPLOAD_MAX_MB=10

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="JK Balaji <no-reply@example.com>"

SWAGGER_ENABLED=false

# GoldAPI.io (server-side only; ~2 requests/day scheduled + optional admin verify/sync)
GOLDAPI_ACCESS_TOKEN=
GOLDAPI_SCHEDULER_ENABLED=true

# GST invoice issuer defaults (configure in admin: Billing → Settings)
COMPANY_GSTIN=
COMPANY_PHONE=
BILLING_TRADE_NAME=
BILLING_LEGAL_NAME=
BILLING_ADDRESS=
BILLING_EMAIL=
BILLING_STATE_CODE=33
BILLING_PAYMENT_TERMS=
BILLING_BANK_DETAILS=
BILLING_CONTACT_EMAIL=tmlcheyyar@gmail.com
BILLING_INVOICE_PREFIX=INV
BILLING_TAX_RATES=0,3,5,12,18
