# PostgreSQL 16/17 tuning for a SMALL VPS shared with Node apps (KVM 1: 4 GB RAM, 1 vCPU).
# Put in /etc/postgresql/<ver>/main/conf.d/jkbalaji.conf and restart PostgreSQL.
listen_addresses = 'localhost'
max_connections = 40
shared_buffers = 512MB
effective_cache_size = 1536MB
work_mem = 8MB
maintenance_work_mem = 128MB
wal_buffers = 16MB
random_page_cost = 1.1          # NVMe
effective_io_concurrency = 200
checkpoint_completion_target = 0.9
max_wal_size = 1GB
min_wal_size = 256MB
log_min_duration_statement = 500   # log slow queries (ms)
timezone = 'UTC'
# KVM 2 (8 GB): shared_buffers = 1GB-2GB, effective_cache_size = 4GB, work_mem = 16MB
