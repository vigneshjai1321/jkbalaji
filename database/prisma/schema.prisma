generator client {
  provider     = "prisma-client"
  output       = "../../backend/api/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  REAL_ESTATE_MANAGER
  SALES_MANAGER
  CRM_EXECUTIVE
  GOLD_MANAGER
  BILLING_STAFF
  ACCOUNTANT
  EMPLOYEE
  STAFF
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  NEGOTIATION
  WON
  LOST
  QUALIFIED
}

enum ProjectPhase {
  ONGOING
  COMPLETED
  UPCOMING
  ALMOST_COMPLETED
  YET_TO_BE_ANNOUNCED
}

enum ProjectLifecycle {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum PropertyKind {
  RESIDENTIAL_PLOT
  CORNER_PLOT
  VILLA
  INDEPENDENT_HOUSE
  FARMLAND
  PLOT_WITH_HOUSE
  OTHER
}

enum AreaUnit {
  SQFT
  SQYD
  SQM
  ACRE
  CENT
}

enum CommissionKind {
  PERCENTAGE
  FIXED
}

enum CommissionPayStatus {
  PENDING
  PARTIAL
  PAID
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

enum PropertyStatus {
  AVAILABLE
  BOOKED
  SOLD
}

enum InvoiceType {
  SALE
  PURCHASE
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum TaxMode {
  CGST_SGST
  IGST
}

enum PlotStatus {
  AVAILABLE
  RESERVED
  SOLD
  BLOCKED
}

enum PlotQuotationStatus {
  DRAFT
  QUOTED
  RESERVATION
  VOID
}

enum PlotChargeKind {
  FIXED
  PERCENT
}

enum PlotChargeBase {
  BASE_PLOT
}

enum CommissionPaidBy {
  SELLER
  BUYER
}

enum CommissionRateSource {
  GLOBAL
  BROKER
  PROJECT
  MANUAL
}

enum CommissionSettingsScope {
  GLOBAL
  BROKER
  PROJECT
}

enum ExpenseCategory {
  SALARY
  RENT
  ELECTRICITY
  INTERNET
  MARKETING
  FUEL
  TRAVEL
  OFFICE
  MISCELLANEOUS
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum SiteKey {
  REAL_ESTATE
  JEWELLERY
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash    String  @map("password_hash")
  passwordHashAlt String? @map("password_hash_alt")
  name         String
  role         UserRole  @default(EMPLOYEE)
  department   String?
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  loginLogs     LoginLog[]
  activityLogs  ActivityLog[]
  assignedLeads Lead[]        @relation("LeadAssignee")
  leadNotes     LeadNote[]
  leadFollowups LeadFollowup[] @relation("FollowupAssignee")
  commissionPaymentsRecorded CommissionPayment[] @relation("CommissionPaymentRecorder")
  commissionSettingsChanges  CommissionSettingsAudit[]

  @@map("users")
}

model LoginLog {
  id           String    @id @default(cuid())
  userId       String?   @map("user_id")
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  emailAttempt String?   @map("email_attempt")
  success      Boolean   @default(false)
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  browser      String?
  device       String?
  location     String?
  failReason   String?   @map("fail_reason")
  loginAt      DateTime  @default(now()) @map("login_at")
  logoutAt     DateTime? @map("logout_at")

  @@index([userId, loginAt])
  @@map("login_logs")
}

model ActivityLog {
  id        String         @id @default(cuid())
  userId    String?        @map("user_id")
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    ActivityAction
  entity    String
  entityId  String?        @map("entity_id")
  summary   String
  metadata  Json?
  ipAddress String?        @map("ip_address")
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String?   @map("user_id")
  title     String
  body      String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Project {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  location    String?
  phase       ProjectPhase @default(ONGOING)
  phaseLabel  String?      @map("phase_label")
  description String?
  coverImage  String?            @map("cover_image")
  published   Boolean            @default(false)
  lifecycle   ProjectLifecycle   @default(ACTIVE)
  notes       String?
  commissionKind  CommissionKind? @map("commission_kind")
  commissionRate  Decimal?        @map("commission_rate") @db.Decimal(14, 2)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  properties  Property[]
  plots           Plot[]
  plotQuotations  PlotQuotation[]
  plotImportReviews PlotImportReview[]
  leads           Lead[]
  commissions     Commission[]

  @@index([published])
  @@map("projects")
}

model Property {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String?
  location    String
  projectName String?        @map("project_name")
  projectId   String?        @map("project_id")
  project     Project?       @relation(fields: [projectId], references: [id])
  plotNo      String?        @map("plot_no")
  kind        PropertyKind   @default(RESIDENTIAL_PLOT)
  areaUnit    AreaUnit       @default(SQFT) @map("area_unit")
  landArea    Decimal?       @map("land_area") @db.Decimal(14, 4)
  areaSqft    Decimal?       @map("area_sqft") @db.Decimal(14, 2)
  builtUpSqft Decimal?       @map("built_up_sqft") @db.Decimal(12, 2)
  carpetSqft  Decimal?       @map("carpet_sqft") @db.Decimal(12, 2)
  priceInr    Decimal        @map("price_inr") @db.Decimal(14, 2)
  status      PropertyStatus @default(AVAILABLE)
  published   Boolean        @default(false)
  featured    Boolean        @default(false)
  brokerId    String?        @map("broker_id")
  broker      Broker?        @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  images      String[]       @default([])
  seoTitle    String?        @map("seo_title")
  seoDesc     String?        @map("seo_desc")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  leads       Lead[]
  commissions Commission[]

  @@index([status])
  @@index([projectId])
  @@map("properties")
}

model Broker {
  id          String       @id @default(cuid())
  code        String?      @unique
  name        String
  phone       String
  email       String?
  address     String?
  notes       String?
  commissionKind  CommissionKind? @map("commission_kind")
  commissionRate  Decimal?        @map("commission_rate") @db.Decimal(14, 2)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  properties  Property[]
  commissions Commission[]
  plots       Plot[]
  plotQuotations PlotQuotation[]

  @@index([phone])
  @@map("brokers")
}

model Commission {
  id            String              @id @default(cuid())
  brokerId      String              @map("broker_id")
  broker        Broker              @relation(fields: [brokerId], references: [id])
  propertyId    String?             @map("property_id")
  property      Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  plotId        String?             @map("plot_id")
  plot          Plot?               @relation(fields: [plotId], references: [id], onDelete: SetNull)
  plotQuotationId String?           @unique @map("plot_quotation_id")
  plotQuotation PlotQuotation?      @relation(fields: [plotQuotationId], references: [id], onDelete: SetNull)
  projectId     String?             @map("project_id")
  project       Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  kind          CommissionKind
  rate          Decimal             @db.Decimal(14, 2)
  rateSource    CommissionRateSource @default(MANUAL) @map("rate_source")
  calculationBasis String           @default("BASE_PLOT") @map("calculation_basis")
  saleValueInr  Decimal?            @map("sale_value_inr") @db.Decimal(14, 2)
  expectedInr   Decimal             @map("expected_inr") @db.Decimal(14, 2)
  paidInr       Decimal             @default(0) @map("paid_inr") @db.Decimal(14, 2)
  status        CommissionPayStatus @default(PENDING)
  paidOn        DateTime?           @map("paid_on") @db.Date
  voided        Boolean             @default(false)
  needsReview   Boolean             @default(false) @map("needs_review")
  notes         String?
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  payments      CommissionPayment[]

  @@index([brokerId])
  @@index([status])
  @@index([projectId])
  @@index([createdAt(sort: Desc)])
  @@index([plotId])
  @@map("commissions")
}

model CommissionPayment {
  id            String     @id @default(cuid())
  commissionId  String     @map("commission_id")
  commission    Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  amountInr     Decimal    @map("amount_inr") @db.Decimal(14, 2)
  paidAt        DateTime   @map("paid_at") @db.Date
  method        String?
  reference     String?    @map("reference")
  notes         String?
  recordedById  String?    @map("recorded_by_id")
  recordedBy    User?      @relation("CommissionPaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  reversedAt    DateTime?  @map("reversed_at")
  reversalOfId  String?    @unique @map("reversal_of_id")
  reversalOf    CommissionPayment? @relation("PaymentReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversal      CommissionPayment? @relation("PaymentReversal")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([commissionId, paidAt(sort: Desc)])
  @@map("commission_payments")
}

model CommissionSettingsAudit {
  id           String                  @id @default(cuid())
  scope        CommissionSettingsScope
  entityId     String?                 @map("entity_id")
  kind         CommissionKind
  rate         Decimal                 @db.Decimal(14, 2)
  previousKind CommissionKind?         @map("previous_kind")
  previousRate Decimal?                @map("previous_rate") @db.Decimal(14, 2)
  changedById  String?                 @map("changed_by_id")
  changedBy    User?                   @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt    DateTime                @default(now()) @map("created_at")

  @@index([scope, createdAt(sort: Desc)])
  @@map("commission_settings_audit")
}

model Lead {
  id           String     @id @default(cuid())
  site         SiteKey    @default(REAL_ESTATE)
  leadType     String?    @map("lead_type")
  name         String
  phone        String
  email        String?
  message      String?
  source       String     @default("WEBSITE")
  sourcePage   String?    @map("source_page")
  status       LeadStatus @default(NEW)
  propertyId   String?    @map("property_id")
  property     Property?  @relation(fields: [propertyId], references: [id])
  projectId    String?    @map("project_id")
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedToId String?    @map("assigned_to_id")
  assignedTo   User?      @relation("LeadAssignee", fields: [assignedToId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  notes        LeadNote[]
  followups    LeadFollowup[]

  @@index([site, status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([projectId])
  @@map("leads")
}

model LeadNote {
  id          String   @id @default(cuid())
  leadId      String   @map("lead_id")
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body        String
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("lead_notes")
}

model LeadFollowup {
  id           String    @id @default(cuid())
  leadId       String    @map("lead_id")
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToId String?   @map("assigned_to_id")
  assignedTo   User?     @relation("FollowupAssignee", fields: [assignedToId], references: [id])
  dueAt        DateTime  @map("due_at")
  completedAt  DateTime? @map("completed_at")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([dueAt, completedAt])
  @@map("lead_followups")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  address   String?
  gstin     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  invoices       Invoice[]
  plots          Plot[]
  plotQuotations PlotQuotation[]

  @@map("customers")
}

model JewelleryProduct {
  id          String   @id @default(cuid())
  productCode String?  @map("product_code")
  name        String
  slug        String   @unique
  description String?
  category    String
  purity      String?
  weightGrams Decimal  @map("weight_grams") @db.Decimal(10, 3)
  makingCharge Decimal @map("making_charge") @db.Decimal(14, 2)
  images      String[] @default([])
  inStock     Boolean  @default(true) @map("in_stock")
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("jewellery_products")
}

model GoldRate {
  id           String   @id @default(cuid())
  rate22k      Decimal  @map("rate_22k") @db.Decimal(10, 2)
  rate24k      Decimal  @map("rate_24k") @db.Decimal(10, 2)
  effectiveDate DateTime @map("effective_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("gold_rates")
}

enum MetalSymbol {
  XAU
  XAG
}

/// Cached GoldAPI.io market benchmarks (not shop selling prices).
model MetalMarketRate {
  id               String      @id @default(cuid())
  metal            MetalSymbol
  currency         String      @default("INR")
  unit             String      @default("gram")
  pricePerGram     Decimal     @map("price_per_gram") @db.Decimal(12, 4)
  price22kPerGram  Decimal?    @map("price_22k_per_gram") @db.Decimal(12, 4)
  price18kPerGram  Decimal?    @map("price_18k_per_gram") @db.Decimal(12, 4)
  provider         String      @default("goldapi.io")
  sourceTimestamp  DateTime?   @map("source_timestamp")
  fetchedAt        DateTime    @default(now()) @map("fetched_at")
  rawPriceTroyOz   Decimal?    @map("raw_price_troy_oz") @db.Decimal(14, 4)
  fetchBatchId     String      @map("fetch_batch_id")
  createdAt        DateTime    @default(now()) @map("created_at")

  @@index([metal, fetchedAt(sort: Desc)])
  @@map("metal_market_rates")
}

model GoldApiDailyFetch {
  id           String   @id @default(cuid())
  fetchDate    DateTime @unique @map("fetch_date") @db.Date
  status       String
  fetchBatchId String?  @map("fetch_batch_id")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("gold_api_daily_fetches")
}

model GoldApiUsageMonth {
  id           String   @id @default(cuid())
  yearMonth    String   @unique @map("year_month")
  requestCount Int      @default(0) @map("request_count")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("gold_api_usage_months")
}

model JewelleryScheme {
  id          String   @id @default(cuid())
  title       String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("jewellery_schemes")
}

model Offer {
  id          String   @id @default(cuid())
  site        SiteKey
  title       String
  description String?
  validUntil  DateTime? @map("valid_until")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("offers")
}

model SiteContent {
  id        String  @id @default(cuid())
  site      SiteKey
  key       String
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([site, key])
  @@map("site_content")
}

model GalleryItem {
  id        String   @id @default(cuid())
  site      SiteKey
  title     String
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("gallery_items")
}

model StockItem {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  quantity    Decimal  @db.Decimal(12, 3)
  unit        String   @default("g")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("stock_items")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNo     String        @unique @map("invoice_no")
  type          InvoiceType   @default(SALE)
  status        InvoiceStatus @default(DRAFT)
  customerId    String        @map("customer_id")
  customer      Customer      @relation(fields: [customerId], references: [id])
  createdById   String?       @map("created_by_id")
  invoiceDate   DateTime      @map("invoice_date") @db.Date
  dueDate       DateTime?     @map("due_date") @db.Date
  paymentTerms  String?       @map("payment_terms")
  taxMode       TaxMode       @default(CGST_SGST) @map("tax_mode")
  gstApplied    Boolean       @default(true) @map("gst_applied")
  placeOfSupply String?       @map("place_of_supply")
  subtotalInr   Decimal       @map("subtotal_inr") @db.Decimal(14, 2)
  discountInr   Decimal       @default(0) @map("discount_inr") @db.Decimal(14, 2)
  cgstInr       Decimal       @map("cgst_inr") @db.Decimal(14, 2)
  sgstInr       Decimal       @map("sgst_inr") @db.Decimal(14, 2)
  igstInr       Decimal       @default(0) @map("igst_inr") @db.Decimal(14, 2)
  totalInr      Decimal       @map("total_inr") @db.Decimal(14, 2)
  amountPaidInr Decimal       @default(0) @map("amount_paid_inr") @db.Decimal(14, 2)
  notes         String?
  issuedAt      DateTime?     @map("issued_at")
  cancelledAt   DateTime?     @map("cancelled_at")
  cancelReason  String?       @map("cancel_reason")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  lines         InvoiceLine[]
  payments      InvoicePayment[]
  events        InvoiceEvent[]

  @@index([status, invoiceDate(sort: Desc)])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  hsnSac      String? @map("hsn_sac")
  unit        String  @default("nos")
  qty         Decimal @db.Decimal(12, 3)
  rateInr     Decimal @map("rate_inr") @db.Decimal(14, 2)
  discountInr Decimal @default(0) @map("discount_inr") @db.Decimal(14, 2)
  gstRatePct  Decimal @default(3) @map("gst_rate_pct") @db.Decimal(5, 2)
  taxableInr  Decimal @default(0) @map("taxable_inr") @db.Decimal(14, 2)
  cgstInr     Decimal @default(0) @map("cgst_inr") @db.Decimal(14, 2)
  sgstInr     Decimal @default(0) @map("sgst_inr") @db.Decimal(14, 2)
  igstInr     Decimal @default(0) @map("igst_inr") @db.Decimal(14, 2)
  amountInr   Decimal @map("amount_inr") @db.Decimal(14, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  @@map("invoice_lines")
}

model InvoicePayment {
  id           String   @id @default(cuid())
  invoiceId    String   @map("invoice_id")
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountInr    Decimal  @map("amount_inr") @db.Decimal(14, 2)
  paidAt       DateTime @default(now()) @map("paid_at")
  method       String?
  reference    String?
  recordedById String?  @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("invoice_payments")
}

model InvoiceEvent {
  id        String   @id @default(cuid())
  invoiceId String   @map("invoice_id")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  action    String
  detail    String?
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([invoiceId, createdAt(sort: Desc)])
  @@map("invoice_events")
}

model InvoiceSequence {
  id          String   @id @default(cuid())
  fiscalYear  Int      @unique @map("fiscal_year")
  lastNumber  Int      @default(0) @map("last_number")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("invoice_sequences")
}

model Plot {
  id              String     @id @default(cuid())
  plotNumber      String     @map("plot_number")
  surveyNumber    String?    @map("survey_number")
  projectId       String?    @map("project_id")
  project         Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  areaSqft        Decimal?   @map("area_sqft") @db.Decimal(12, 2)
  lengthFt        Decimal?   @map("length_ft") @db.Decimal(10, 2)
  widthFt         Decimal?   @map("width_ft") @db.Decimal(10, 2)
  description     String?
  facing          String?
  status          PlotStatus @default(AVAILABLE)
  archived        Boolean    @default(false)
  customerId      String?    @map("customer_id")
  customer        Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  brokerId        String?    @map("broker_id")
  broker          Broker?    @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  pricePerSqftInr Decimal?   @map("price_per_sqft_inr") @db.Decimal(14, 2)
  priceInr        Decimal?   @map("price_inr") @db.Decimal(14, 2)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  quotations      PlotQuotation[]
  commissions     Commission[]
  events          PlotEvent[]

  @@unique([projectId, plotNumber])
  @@index([status])
  @@index([projectId])
  @@index([archived])
  @@index([brokerId])
  @@map("plots")
}

model PlotImportReview {
  id                 String   @id @default(cuid())
  projectId          String   @map("project_id")
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suppliedPlotNumber String   @map("supplied_plot_number")
  areaSqft           Decimal  @map("area_sqft") @db.Decimal(12, 2)
  reason             String
  sourceNote         String?  @map("source_note")
  resolvedPlotId     String?  @map("resolved_plot_id")
  resolvedAt         DateTime? @map("resolved_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("plot_import_reviews")
}

model PlotQuotation {
  id                       String              @id @default(cuid())
  projectId                String              @map("project_id")
  project                  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plotId                   String              @map("plot_id")
  plot                     Plot                @relation(fields: [plotId], references: [id], onDelete: Cascade)
  customerId               String              @map("customer_id")
  customer                 Customer            @relation(fields: [customerId], references: [id])
  status                   PlotQuotationStatus @default(DRAFT)
  pricePerSqftInr          Decimal             @map("price_per_sqft_inr") @db.Decimal(14, 2)
  basePlotPriceInr         Decimal             @map("base_plot_price_inr") @db.Decimal(14, 2)
  additionalTotalInr       Decimal             @default(0) @map("additional_total_inr") @db.Decimal(14, 2)
  estimatedTotalInr        Decimal             @map("estimated_total_inr") @db.Decimal(14, 2)
  includeCommissionInTotal Boolean             @default(false) @map("include_commission_in_total")
  brokerId                 String?             @map("broker_id")
  broker                   Broker?             @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  commissionKind           CommissionKind?     @map("commission_kind")
  commissionRate           Decimal?            @map("commission_rate") @db.Decimal(14, 2)
  commissionBase           PlotChargeBase?     @default(BASE_PLOT) @map("commission_base")
  commissionExpectedInr    Decimal?            @map("commission_expected_inr") @db.Decimal(14, 2)
  commissionPaidBy         CommissionPaidBy?   @default(SELLER) @map("commission_paid_by")
  validUntil               DateTime?           @map("valid_until") @db.Date
  notes                    String?
  terms                    String?
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")
  charges                  PlotQuotationCharge[]
  commission               Commission?

  @@index([projectId])
  @@index([plotId])
  @@index([customerId])
  @@index([status])
  @@map("plot_quotations")
}

model PlotQuotationCharge {
  id             String         @id @default(cuid())
  quotationId    String         @map("quotation_id")
  quotation      PlotQuotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  label          String
  kind           PlotChargeKind
  fixedAmountInr Decimal?       @map("fixed_amount_inr") @db.Decimal(14, 2)
  percentRate    Decimal?       @map("percent_rate") @db.Decimal(8, 4)
  percentBase    PlotChargeBase? @map("percent_base")
  amountInr      Decimal        @map("amount_inr") @db.Decimal(14, 2)
  sortOrder      Int            @default(0) @map("sort_order")

  @@index([quotationId])
  @@map("plot_quotation_charges")
}

model PlotEvent {
  id        String   @id @default(cuid())
  plotId    String   @map("plot_id")
  plot      Plot     @relation(fields: [plotId], references: [id], onDelete: Cascade)
  action    String
  detail    String?
  createdById String? @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([plotId])
  @@map("plot_events")
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  amountInr   Decimal         @map("amount_inr") @db.Decimal(14, 2)
  description String?
  expenseDate DateTime        @map("expense_date") @db.Date
  createdById String?         @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([expenseDate])
  @@index([category])
  @@map("expenses")
}

model Account {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  type      AccountType
  createdAt DateTime    @default(now()) @map("created_at")
  lines     JournalLine[]

  @@map("accounts")
}

model JournalEntry {
  id          String        @id @default(cuid())
  entryDate   DateTime      @map("entry_date") @db.Date
  narration   String?
  createdById String?       @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  lines       JournalLine[]

  @@index([entryDate])
  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String       @map("journal_entry_id")
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String       @map("account_id")
  account        Account      @relation(fields: [accountId], references: [id])
  debitInr       Decimal      @default(0) @map("debit_inr") @db.Decimal(14, 2)
  creditInr      Decimal      @default(0) @map("credit_inr") @db.Decimal(14, 2)

  @@map("journal_lines")
}
